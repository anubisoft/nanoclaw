TELEGRAM_BOT_TOKEN=

# Optional: OpenAI for Whisper (voice/audio/video notes) and TTS (voice replies).
# Either set OPENAI_API_KEY here, or omit it and use OneCLI with an OpenAI secret for api.openai.com
# (requires ONECLI_URL — same proxy path as agent containers).
OPENAI_API_KEY=

# OneCLI (optional): when OPENAI_API_KEY is unset, NanoClaw fetches /api/container-config and calls
# OpenAI through the same HTTPS proxy as agent containers. Set ONECLI_URL to a URL reachable from
# this process (from Docker: often http://172.17.0.1:<port> or http://host.docker.internal:<port>).
# ONECLI_API_KEY=   # if your OneCLI /api/container-config requires Authorization: Bearer
ONECLI_URL=

# Optional: HTTPS URL of the Telegram Mini App (e.g. https://tma.anubisoft.ai/).
# When set, the bot sets the default menu button to open this Web App (NanoClaw status UI).
TELEGRAM_MINI_APP_URL=

# CycleTrak Mini App (bike shop UI at cycletrak.* — separate from TELEGRAM_MINI_APP_URL).
# CYCLETRAK_MINI_APP_URL defaults to https://cycletrak.anubisoft.ai/ if unset.
# Set CYCLETRAK_TELEGRAM_GROUP_CHAT_ID to your supergroup id (run /chatid in that group), then restart nanoclaw.
# In BotFather, add the same HTTPS domain under the bot’s Mini App settings so the Web App opens.
CYCLETRAK_MINI_APP_URL=
CYCLETRAK_TELEGRAM_GROUP_CHAT_ID=

# Optional: read-only HTTP status for the Mini App backend (Bearer secret).
# Bind 127.0.0.1 on the host; use 0.0.0.0 inside Docker when Next.js reaches this service on the compose network.
NANOCLAW_TMA_STATUS_PORT=
NANOCLAW_TMA_STATUS_SECRET=
NANOCLAW_TMA_STATUS_HOST=
# Optional: override the URL Next.js uses (same Compose project). If unset, Next.js uses http://nanoclaw:<NANOCLAW_TMA_STATUS_PORT>.
# NANOCLAW_TMA_STATUS_URL=http://nanoclaw:9847
